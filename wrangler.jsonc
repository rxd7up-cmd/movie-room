{
  "name": "movie-room",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/ws"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "MOVIE_ROOM",
        "class_name": "MovieRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MovieRoom"
      ]
    }
  ]
}
